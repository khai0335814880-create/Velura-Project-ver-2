# Velura deployment environment
# Copy this file to .env for local use, or configure the same variables on the hosting platform.
# Never commit real passwords, service-role keys, database URLs, SMTP credentials, or AI API keys.

# --- INFRASTRUCTURE & PRODUCTION URLS ---
NODE_ENV=production
PORT=8787
API_ORIGIN=https://api.yourdomain.com
VITE_API_BASE_URL=https://api.yourdomain.com
CORS_ORIGIN=https://user.yourdomain.com,https://admin.yourdomain.com

# --- SUPABASE PUBLIC CONFIG (Frontend build + API) ---
# Supabase Dashboard > Project Settings > API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_publishable_key

# --- SUPABASE SERVER-ONLY SECRETS ---
# Never prefix the service-role key with VITE_.
VELURA_SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Transaction Pooler example. Percent-encode every special character in the password.
# Example: literal @ becomes %40; literal % becomes %25.
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:[PERCENT_ENCODED_PASSWORD]@aws-0-your-region.pooler.supabase.com:6543/postgres

# --- API LIMITS & WORKERS ---
API_REQUEST_TIMEOUT_MS=15000
API_MAX_BODY_BYTES=15728640
ADMIN_MUTATION_LIMIT_PER_MINUTE=60
ACCOUNT_MAINTENANCE_INTERVAL_MS=3600000
EMAIL_WORKER_INTERVAL_MS=60000
EMAIL_WEBHOOK_URL=
EMAIL_WEBHOOK_TOKEN=

# --- SMTP EMAIL ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_APP_PASSWORD=
SMTP_FROM="Velura Support <support@yourdomain.com>"
SUPPORT_ALERT_TO=

# --- CHATBOT & AI SERVICES ---
N8N_CHAT_WEBHOOK_URL=
N8N_CHAT_WEBHOOK_TOKEN=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_STYLIST_MODEL=gemini-3.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSIONS=1536
RECOMMENDATION_MATCH_THRESHOLD=0.45
RECOMMENDATION_MATCH_COUNT=20
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# --- LOCAL DEVELOPMENT & SMOKE TESTS ONLY ---
DEV_HOST=localhost
ADMIN_WEB_PORT=5174
USER_WEB_PORT=3001
API_PROXY_TARGET=http://localhost:8787
SMOKE_API_HOST=127.0.0.1
SMOKE_API_PORT=8799
